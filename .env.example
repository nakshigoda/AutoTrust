# AutoTrust Environment Configuration Template
# Copy this file to .env (or blockchain/.env for smart contract deployment) and update the values.

# Blockchain Network RPC
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# Admin / Deployer Private Key for Smart Contract Deployments
# CAUTION: Never commit real private keys or wallet credentials.
PRIVATE_KEY="your_deployer_private_key_here"

# (Optional) Test Actor Private Keys for CLI Scripts
SERVICE_CENTER_PRIVATE_KEY="your_service_center_private_key_here"
INSURANCE_PRIVATE_KEY="your_insurance_private_key_here"
